# Claude Code per-developer state — local-only, never commit.
# Covers the canonical settings.local.json plus any future
# `<feature>.local.json` / `<name>.local` files Claude may introduce.
*.local.json
*.local

# Temporary checkouts created by `Agent` calls with isolation: "worktree".
worktrees/

# Local-only memos / deferred-decision logs that should not be shared.
notes/

# Runtime lock for Claude Code scheduled tasks (session/pid/timestamps).
scheduled_tasks.lock
